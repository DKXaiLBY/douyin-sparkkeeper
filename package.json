{
  "name": "douyin-streak",
  "version": "1.0.0",
  "private": true,
  "description": "抖音火花守护 SparkKeeper · 本地优先、合规可控的火花续火 Web 应用",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev:server": "npm --prefix server run dev",
    "dev:web": "npm --prefix web run dev",
    "build:web": "npm --prefix web run build",
    "install:all": "npm install && npm --prefix server install && npm --prefix web install",
    "start": "npm --prefix server run start",
    "test": "vitest run",
    "test:server": "npm --prefix server run test",
    "test:web": "vitest run tests/web",
    "verify:node": "node --experimental-strip-types tests/server/vault.verify.mjs && node --experimental-strip-types tests/server/content.verify.mjs",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "jsdom": "^25.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vitest": "^2.1.1"
  }
}
