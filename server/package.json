{
  "name": "sparkkeeper-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "抖音火花守护 后端服务（Express + better-sqlite3 + Playwright 适配器）",
  "license": "MIT",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --import tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "dotenv": "^16.4.5",
    "douyin-streak": "file:..",
    "express": "^4.19.2",
    "node-cron": "^3.0.3",
    "pino": "^9.4.0",
    "tsx": "^4.19.0",
    "zod": "^3.23.8"
  },
  "optionalDependencies": {
    "playwright": "^1.62.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "@types/node-cron": "^3.0.11",
    "typescript": "^5.5.4",
    "vitest": "^2.1.1"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
