# ============================================================
# 抖音火花守护 · 环境变量样例（复制为 .env 并填写）
# 说明：所有字段均可不写，将使用「安全默认值」。
# 重点：APP_PASSPHRASE 用于加密/解密本地凭证，建议用 secret 注入而非写文件。
# ============================================================

# ---- 服务 ----
PORT=3000
DATA_DIR=./data
# 时区（影响错峰窗口与每日触发判定）
TZ=Asia/Shanghai

# ---- 凭证加密口令 ----
# 用于 AES-256-GCM 派生密钥；启动与导入时必须一致。
# 若未设置，应用仍可用 Mock 模式 / Dry Run 运行，但真正发送需先设置。
#
# 设置后：后端进程启动时会自动解锁保险库，界面上不用每次重启都重输口令。
# 代价：口令以明文存在本机 .env 文件里。请自行权衡——
#       机器只有你一个人用、且已开启系统登录密码时，风险可接受；
#       共用电脑或不受信环境请勿设置。
# .env 已在 .gitignore 中，不会被提交到 Git。
# APP_PASSPHRASE=change-me-please

# ---- 平台适配器 ----
# douyin（真实 Playwright 网页自动化）| mock（开发/测试，无需登录）
PLATFORM=mock

# ---- 安全模式（默认开启，强烈建议保持 true）----
SAFETY_MODE=true
DAILY_CAP=20
DELAY_MIN_SEC=30
DELAY_MAX_SEC=180
STAGGER_START_HOUR=19
STAGGER_END_HOUR=22

# ---- 每日触发（node-cron 表达式，默认每天 20:00 本地）----
CRON=0 20 * * *

# ---- 内容引擎（默认本地模板，不调用外部 LLM）----
LLM_ENABLED=false
# LLM_PROVIDER=deepseek
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
# LLM_API_KEY=sk-xxxx   # 也可在设置页填，会以同样方式加密存储

# ---- 通知 ----
NOTIFY_CHANNEL=none   # none | webhook | telegram
# NOTIFY_WEBHOOK_URL=https://example.com/hook
# NOTIFY_TELEGRAM_TOKEN=123456:ABC-DEF
# NOTIFY_TELEGRAM_CHAT_ID=987654321

# ---- 天气数据源（Open-Meteo，免 key；设为 false 则不注入天气）----
WEATHER_ENABLED=true

# ---- 口令最小长度（防呆）----
PASSPHRASE_MIN_LEN=8

# ---- 监听地址（默认 127.0.0.1 仅本机；Docker 部署 compose 已设 0.0.0.0）----
# HOST=0.0.0.0
